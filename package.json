{
  "name": "dendra",
  "version": "0.13.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeestack/dendra.git"
  },
  "homepage": "https://products.techfoundry.io/dendra/",
  "bugs": "https://github.com/zeestack/dendra/issues",
  "description": "Lightweight, decorator-free, codegen-free typed RPC/REST framework for Next.js and any Web-standard runtime — with first-class AI/MCP tool support.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./anthropic": {
      "import": {
        "types": "./dist/anthropic.d.ts",
        "default": "./dist/anthropic.js"
      },
      "require": {
        "types": "./dist/anthropic.d.cts",
        "default": "./dist/anthropic.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory.d.ts",
        "default": "./dist/memory.js"
      },
      "require": {
        "types": "./dist/memory.d.cts",
        "default": "./dist/memory.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./adapter": {
      "import": {
        "types": "./dist/adapter.d.ts",
        "default": "./dist/adapter.js"
      },
      "require": {
        "types": "./dist/adapter.d.cts",
        "default": "./dist/adapter.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "anthropic": [
        "./dist/anthropic.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "memory": [
        "./dist/memory.d.ts"
      ],
      "next": [
        "./dist/next.d.ts"
      ],
      "adapter": [
        "./dist/adapter.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "next": ">=14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node examples/demo.ts",
    "demo:restws": "node examples/rest-ws-demo.ts",
    "prepublishOnly": "npm run build",
    "check:package": "publint --strict && attw --pack .",
    "bench": "node bench/run.ts"
  },
  "keywords": [
    "rpc",
    "rest",
    "typescript",
    "nextjs",
    "openapi",
    "mcp",
    "ai",
    "streaming",
    "typed-client",
    "trpc-alternative",
    "model-context-protocol",
    "mcp-server",
    "llm-tools",
    "ai-agents"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-test-renderer": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@valibot/to-json-schema": "^1.8.0",
    "arktype": "^2.2.8",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "valibot": "^1.5.0",
    "vitest": "^2.1.9",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
