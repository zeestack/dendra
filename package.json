{
  "name": "dendra",
  "version": "0.5.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeestack/dendra.git"
  },
  "homepage": "https://github.com/zeestack/dendra#readme",
  "bugs": "https://github.com/zeestack/dendra/issues",
  "description": "Lightweight, decorator-free, codegen-free typed RPC/REST framework for Next.js and any Web-standard runtime — with first-class AI/MCP tool support.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js",
      "require": "./dist/anthropic.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "require": "./dist/memory.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node examples/demo.ts",
    "demo:restws": "node examples/rest-ws-demo.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rpc",
    "rest",
    "typescript",
    "nextjs",
    "openapi",
    "mcp",
    "ai",
    "streaming",
    "typed-client"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
