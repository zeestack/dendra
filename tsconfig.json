{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    // `next` has no exports map, so NodeNext can't see `next/headers` or
    // `next/navigation`; Next itself needs those exact specifiers (it aliases
    // them in Server Components).
    "paths": {
      "next/headers": ["./node_modules/next/headers.d.ts"],
      "next/navigation": ["./node_modules/next/navigation.d.ts"]
    }
  },
  "include": ["src", "examples", "test"],
  "exclude": ["node_modules", "examples/nextjs-app", "dist"]
}
